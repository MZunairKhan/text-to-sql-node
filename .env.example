# --- Postgres (superuser, used only for container bootstrap) ---
POSTGRES_DB=appdb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_superuser

# --- Least-privilege role the API actually connects as ---
APP_READONLY_PASSWORD=change_me_readonly

# --- API ---
# Built from the values above — app_readonly, never the superuser.
DATABASE_URL=postgres://app_readonly:change_me_readonly@localhost:5432/appdb
ANTHROPIC_API_KEY=sk-ant-your-key-here
