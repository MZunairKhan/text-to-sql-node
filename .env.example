# --- Postgres (superuser, used only for container bootstrap) ---
POSTGRES_DB=appdb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_superuser

# --- Least-privilege role the API actually connects as ---
APP_READONLY_PASSWORD=change_me_readonly

# --- Pipeline role: SELECT/INSERT/UPDATE on schema_embeddings only,
#     used solely by `npm run embed:schema` ---
APP_PIPELINE_PASSWORD=change_me_pipeline

# --- LLM / embedding providers ---
ANTHROPIC_API_KEY=sk-ant-your-key-here
VOYAGE_API_KEY=sk-voy-your-key-here
VOYAGE_MODEL=voyage-4-lite
