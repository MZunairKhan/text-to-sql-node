# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies — the ** matches node_modules at any depth (api/, frontend/, etc.)
**/node_modules

# testing
**/coverage

# production
**/build
**/dist

# env files — never commit real secrets; .env.example stays tracked
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# misc
.DS_Store
Thumbs.db

npm-debug.log*
yarn-debug.log*
yarn-error.log*